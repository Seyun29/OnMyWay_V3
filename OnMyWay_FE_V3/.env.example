# ===== OnMyWay FE 환경변수 (react-native-dotenv, @env) =====
# 사용법: cp .env.example .env 후 실제 값 입력 (.env는 절대 커밋 금지)
# 값 변경 후에는 Metro 캐시 리셋 필요: npm start -- --reset-cache

# 로컬 개발 BE 포트. host는 Platform.OS로 자동 선택되므로 플랫폼별 수정이 불필요하다.
#  - iOS 시뮬레이터    → http://localhost:3005
#  - Android 에뮬레이터 → http://10.0.2.2:3005
# BE .env의 PORT와 반드시 일치시킬 것.
SERVER_PORT=3005

# 로컬 시뮬레이터에서는 비워둔다.
# 실기기에는 http://{맥북 로컬 IP}:3005, production에는 전체 http/https URL을 지정한다.
# Production: https://onmywayv2-production.up.railway.app
# EAS Build/Update에서는 EAS production environment에도 같은 SERVER_BASEURL을 등록한다.
SERVER_BASEURL=

# 앱 메타 (Store identity 및 native 설정에 사용)
APP_NAME=OnMyWay
ANDROID_PACKAGE_NAME=com.omw.omw_front
IOS_BUNDLE_ID=com.omw.onmywayapp

# Google Maps Platform mobile SDK keys. Restrict each key to its platform/app identity.
GOOGLE_MAPS_ANDROID_API_KEY=your_google_maps_android_api_key
GOOGLE_MAPS_IOS_API_KEY=your_google_maps_ios_api_key

# Naver Maps mobile SDK client identifier. Keep the real value in ignored .env only.
NAVER_MAP_CLIENT_ID=your_naver_map_client_id
