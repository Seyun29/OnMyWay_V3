{
  "enabled": true,
  "name": "Secret guard",
  "description": "Block literal keys, passwords and private origins from entering config, native or documentation files.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/.env.example",
      "**/*.json",
      "**/*.yml",
      "**/*.yaml",
      "**/*.gradle",
      "**/*.properties",
      "**/*.plist",
      "**/*.xml",
      "**/Dockerfile",
      "docs/**/*.md",
      "legacy/**"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the edited file against .kiro/steering/security-and-observability.md. Report any literal API key, password, token, signing value, certificate fingerprint, AWS account ID, private host name, EAS project ID or update URL that is not a placeholder. For each finding give the file and line, replace the value with a placeholder (for example <MASKED_...> in legacy/ or an environment variable reference in active code), and never echo the original value in your answer."
  }
}
