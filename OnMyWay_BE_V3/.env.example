# ===== OnMyWay BE 환경변수 =====
# 사용법: cp .env.example .env 후 실제 값 입력 (.env는 절대 커밋 금지)

# 서버
# 로컬 기본값은 3005다. Production에서는 Railway 등 배포 플랫폼이 주입한 PORT를 사용한다.
# 외부 http/https와 80/443 처리는 reverse proxy가 담당하므로 앱에서 고정하지 않는다.
PORT=3005
MODE=dev                          # dev | prod (Swagger 노출 등 분기)
# 지도 API provider는 FE의 Accept-Language에 따라 요청별로 선택된다.
# ko: Kakao 전체 API, 그 외(현재 UI는 en): Google Maps Platform 전체 API

# Google Maps Platform 서버 키
# API restriction: Places API (New), Routes API, Geocoding API만 허용
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key

# Legacy provider/API — Google 전환 완료 후 제거 예정
# Kakao Local API 형식: "KakaoAK {REST_API_KEY}"
KAKAO_API_KEY=KakaoAK your_kakao_rest_api_key
# OpenAI API 형식: "Bearer sk-..."
OPENAI_HEADER_AUTH=Bearer your_openai_api_key

# Swagger (/docs) basic auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=change_me
